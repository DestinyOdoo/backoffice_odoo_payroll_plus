<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <!--
        Grupo para acceso al portal de novedades.
        No es implicado por base.group_portal, por lo que los usuarios portal
        no lo tienen por defecto. Se asigna manualmente a los empleados que
        deben poder gestionar novedades desde el frontend.
        -->
        <record id="group_hr_novelty_portal" model="res.groups">
            <field name="name">Novedades (Portal)</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="comment">Permite ver y crear novedades desde el portal (/my/novedades). Sin este permiso, los usuarios portal no pueden acceder.</field>
        </record>
</odoo>
