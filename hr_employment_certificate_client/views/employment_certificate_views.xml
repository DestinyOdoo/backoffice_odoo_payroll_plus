<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employment_certificate_tree" model="ir.ui.view">
        <field name="name">hr.employment.certificate.tree</field>
        <field name="model">hr.employment.certificate</field>
        <field name="arch" type="xml">
            <tree string="Certificados laborales">
                <field name="employee_id"/>
                <field name="contract_id"/>
                <field name="request_date"/>
                <field name="download_date"/>
                <field name="state"/>
                <field name="report_attachment_id" string="Archivo descargado" optional="show"/>
                <button name="action_download_pdf" type="object" string="Descargar" icon="fa-download" title="Descargar PDF"/>
            </tree>
        </field>
    </record>
    <record id="view_hr_employment_certificate_form" model="ir.ui.view">
        <field name="name">hr.employment.certificate.form</field>
        <field name="model">hr.employment.certificate</field>
        <field name="arch" type="xml">
            <form string="Certificado laboral">
                <sheet>
                    <group>
                        <field name="employee_id"/>
                        <field name="contract_id"/>
                        <field name="request_date"/>
                        <field name="download_date"/>
                        <field name="state"/>
                        <field name="report_attachment_id" string="Archivo descargado" readonly="1"/>
                    </group>
                    <footer>
                        <button name="action_generate" string="Marcar como generado" type="object" class="btn-primary" invisible="state != 'draft'"/>
                        <button name="action_download_pdf" string="Descargar PDF" type="object" class="btn-secondary" data-hotkey="d"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_hr_employment_certificate" model="ir.actions.act_window">
        <field name="name">Certificados laborales</field>
        <field name="res_model">hr.employment.certificate</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay solicitudes de certificado laboral.
            </p>
            <p>
                Los empleados pueden solicitar su certificado desde el portal (Mi cuenta → Certificado laboral).
                Aquí se listan todas las solicitudes con fecha y el PDF generado.
            </p>
        </field>
    </record>

    <menuitem id="menu_hr_employment_certificate"
              name="Certificados laborales"
              action="action_hr_employment_certificate"
              parent="hr.menu_hr_root"
              sequence="45"/>
</odoo>
