<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_certificate_inherit" model="ir.ui.view">
        <field name="name">res.company.form.certificate.laboral</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <field name="vat" position="after">
                <group string="Certificado laboral" name="employment_certificate">
                    <field name="certificate_logo"/>
                    <field name="certificate_signature"/>
                    <field name="certificate_signer_name"/>
                    <field name="certificate_signer_job_title"/>
                    <field name="certificate_city"/>
                </group>
            </field>
        </field>
    </record>
</odoo>
