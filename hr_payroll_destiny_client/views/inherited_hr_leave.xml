<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_leave_view_form_manager_inherit" model="ir.ui.view">
        <field name="name">hr.leave.form.inherit</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id"
               ref="hr_holidays.hr_leave_view_form_manager"/>
        <field name="arch" type="xml">
            <!-- payslip_state no existe en hr_leave_view_form_manager (Odoo 17) -->
            <field name="holiday_status_id" position="after">
                <field name="description"/>
            </field>
        </field>
    </record>

</odoo>
