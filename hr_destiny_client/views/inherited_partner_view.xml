<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="view_partner_form_inherit" model="ir.ui.view">
            <field name="name">res.partner.form.view.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <field name="vat" position="attributes">
                    <attribute name="string">Document Number</attribute>
                    <attribute name="required">1</attribute>
                </field>
                <field name="state_id" position="attributes">
                    <attribute name="required">1</attribute>
                </field>
                <field name="mobile" position="attributes">
                    <attribute name="required">1</attribute>
                </field>
                <field name="email" position="attributes">
                    <attribute name="required">1</attribute>
                </field>
                <field name="mobile" position="before">
                    <field name="mobile_country_code" width='50%'/>
                </field>
                <field name="phone" position="before">
                    <field name="phone_country_code"/>
                </field>
                <field name="vat" position="after">
                    <field name="client_reference"/>
                </field>
                <xpath expr="//notebook" position="inside">
                    <page name="features" string="Features">
                        <group col="4">
                            <field name="is_found_layoffs"/>
                            <field name="is_compensation_box"/>
                            <field name="is_eps"/>
                            <field name="is_unemployee_fund"/>
                            <field name="is_arl"/>
                            <field name="is_prepaid_medicine"/>
                            <field name="is_afc"/>
                            <field name="is_afp"/>
                            <field name="is_voluntary_contribution"/>
                            <field name="is_sena"/>
                            <field name="is_icbf"/>
                        </group>
                    </page>
                    <page string="File Details">
                        <group col="4">
                            <field name="file_cv"/>
                            <field name="file_cv_name"/>
                            <field name="file_cv_size"/>
                            <field name="linked_return_url"/>
                            <field name="attachment_url" widget="url"/>
                        </group>
                    </page>
                </xpath>
                <xpath expr="//div[hasclass('o_address_format')]" position="replace">
                    <div class="o_address_format">
                        <field name="street" placeholder="Street..." class="o_address_street" readonly="type == 'contact' and parent_id"/>
                        <field name="street2" placeholder="Street 2..." class="o_address_street" readonly="type == 'contact' and parent_id"/>
                        <field name="country_id" placeholder="Country" class="o_address_country" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}" readonly="type == 'contact' and parent_id"/>
                        <field name="state_id" class="o_address_state" placeholder="State" options="{'no_open': True, 'no_quick_create': True}" readonly="type == 'contact' and parent_id" context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
                        <field name="city" placeholder="City" class="o_address_city" readonly="type == 'contact' and parent_id"/>
                        <field name="zip" placeholder="ZIP" class="o_address_zip" readonly="type == 'contact' and parent_id"/>
                    </div>
                </xpath>
                <xpath expr="//div[hasclass('o_address_format')]//field[@name='city']" position="attributes">
                    <attribute name='invisible'>1</attribute>
                </xpath>
                <xpath expr="//div[hasclass('o_address_format')]//field[@name='state_id']" position="after">
                    <field name="city_id" placeholder="City" class="o_address_city" domain="[('state_id', '=', state_id)]"/>
                </xpath>
                <xpath expr="//group[1]/group[2]/field[@name='function']" position="replace">
                    <field name="function_id" placeholder="e.g. Sales Director" invisible="is_company"/>
                </xpath>
                <xpath expr="//field[@name='child_ids']/kanban/field[@name='function']" position="replace">
                    <field name="function_id" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                </xpath>
                <xpath expr="//div[@t-if='record.function.raw_value']" position="replace">
                    <div t-if="record.function_id.raw_value"><field name="function_id"/></div>
                </xpath>
                <xpath expr="//field[@name='function']" position="replace">
                    <field name="function_id" placeholder="e.g. Sales Director" invisible="type != 'contact'"/>
                </xpath>
            </field>
        </record>

        <record id="view_res_partner_filter_inherit" model="ir.ui.view">
            <field name="name">view.res.partner.filter.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_res_partner_filter"/>
            <field name="arch" type="xml">
                <filter name="inactive" position="after">
                    <filter string="Found Layoffs" name="is_found_layoffs" domain="[('is_found_layoffs','!=',False)]"/>
                    <filter string="Compensation Box" name="is_compensation_box" domain="[('is_compensation_box','!=',False)]"/>
                    <filter string="EPS" name="is_eps" domain="[('is_eps','!=',False)]"/>
                    <filter string="Unemployee Fund" name="is_unemployee_fund" domain="[('is_unemployee_fund','!=',False)]"/>
                    <filter string="ARL" name="is_arl" domain="[('is_arl','!=',False)]"/>
                    <filter string="Prepaid Medicine" name="is_prepaid_medicine" domain="[('is_prepaid_medicine','!=',False)]"/>
                    <filter string="AFC" name="is_afc" domain="[('is_afc','!=',False)]"/>
                    <filter string="AFP" name="is_afp" domain="[('is_afp','!=',False)]"/>
                    <filter string="Voluntary Contribution" name="is_voluntary_contribution" domain="[('is_voluntary_contribution','!=',False)]"/>
                </filter>
            </field>
        </record>

        <record id="view_res_users_form_inherit_token" model="ir.ui.view">
            <field name="name">res.users.form.view.inherit.token</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <field name="action_id" position="after">
                    <field name="you_websocket_token"/>
                    <field name="birthdate"/>
                    <field name="wp_api_token"/>
                    <field name="cognito_sub"/>
                </field>
            </field>
        </record>

        <record id="res_partner_kanban_view_inherit" model="ir.ui.view">
            <field name="name">res.partner.kanban.view.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.res_partner_kanban_view"/>
            <field name="arch" type="xml">
                <!-- Add required fields -->
                <xpath expr="//kanban" position="inside">
                    <field name="company_type"/>
                    <field name="is_company"/>
                </xpath>

                <xpath expr="//kanban[1]/field[@name='function']" position="replace">
                    <field name="function_id"/>
                </xpath>

                <xpath expr="//div[hasclass('oe_kanban_details')]" position="replace">
                    <div class="oe_kanban_details">
                        <strong class="o_kanban_record_title">
                            <field name="name"/>
                        </strong>
                        <div class="o_kanban_tags_section oe_kanban_partner_categories"/>
                        <div class="text-muted">
                            <div t-if="record.parent_id.raw_value and !record.function_id.raw_value" class="o_force_ltr">
                                <field name="parent_id"/>
                            </div>
                            <div t-if="!record.parent_id.raw_value and record.function_id.raw_value" class="o_force_ltr">
                                <field name="function_id"/>
                            </div>
                            <div t-if="record.parent_id.raw_value and record.function_id.raw_value" class="o_force_ltr">
                                <field name="function_id"/> at <field name="parent_id"/>
                            </div>
                            <div t-if="record.city.raw_value or record.country_id.raw_value" class="o_force_ltr">
                                <t t-if="record.city.raw_value">
                                    <field name="city"/>
                                </t>
                                <t t-if="record.city.raw_value and record.country_id.raw_value">, </t>
                                <t t-if="record.country_id.raw_value">
                                    <field name="country_id"/>
                                </t>
                            </div>
                            <div t-if="record.email.raw_value" class="o_force_ltr o_text_overflow">
                                <field name="email"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left"/>
                                <div class="oe_kanban_bottom_right"/>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
</odoo>

