<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_salary_structure_type_view_tree" model="ir.ui.view">
        <field name="name">hr.salary.structure.type.view.tree</field>
        <field name="model">hr.salary.structure.type</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name" required="1"/>
            </tree>
        </field>
    </record>

    <record id="hr_salary_structure_type_action" model="ir.actions.act_window">
        <field name="name">Hr Salary Structure Type</field>
        <field name="res_model">hr.salary.structure.type</field>
        <field name="view_mode">tree</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="hr_salary_structure_type_menu_action"
        name="Hr Salary Structure Type"
        action="hr_salary_structure_type_action"
        parent="menu_hr_config_novelty"
        sequence="12"/>

</odoo>
