<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_job_salary_view_tree" model="ir.ui.view">
        <field name="name">hr.job.salary.view.tree</field>
        <field name="model">hr.job.salary</field>
        <field name="arch" type="xml">
            <tree>
                <field name="job_id"/>
                <field name="name"/>
                <field name="value"/>
            </tree>
        </field>
    </record>

    <record id="hr_job_salary_view_form" model="ir.ui.view">
        <field name="name">hr.job.salary.view.form</field>
        <field name="model">hr.job.salary</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group colspan="4" col="4">
                            <field name="job_id" required="1"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="name" required="1"/>
                            <field name="value"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_job_salary_action" model="ir.actions.act_window">
        <field name="name">Salaries</field>
        <field name="res_model">hr.job.salary</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>

    <menuitem
        id="hr_job_salary_menu_action"
        name="Salaries"
        action="hr_job_salary_action"
        parent="hr_recruitment.menu_hr_recruitment_configuration"/>

</odoo>
