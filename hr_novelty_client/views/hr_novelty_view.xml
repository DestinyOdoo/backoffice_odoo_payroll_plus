	<!-- Novelty Notifications Form View-->

	<record model="ir.ui.view" id="view_hr_novelty_form_notifications">
		<field name="name">hr.novelty.form.custom</field>
		<field name="model">hr.novelty</field>
		<field name="type">form</field>
		<field name="arch" type="xml">
			<form string="hr.novelty">
				<header>
					<button name="action_wait" type="object"
							string="Wait" invisible="state not in ('draft')"/>

					<button name="action_wait_comments" type="object"
							string="Wait for Comments" invisible="state not in ('wait')"/>

					<button name="action_second_approval" type="object"
							string="Second Approve"
							invisible="not is_sec_appr_user or state in ('draft','wait', 'approved', 'processed')"/>

					<button name="action_approve" type="object"
							string="Approve"
							invisible="not is_user_appr or state not in ('wait_comments')"/>
					<button name="action_reject" type="object"
							string="Reject"
							invisible="state not in ('wait', 'wait_comments', 'wait_second_approval') and is_user_appr or is_sec_appr_user"/>

					<button name="action_process" type="object"
							string="Process" invisible="state not in ('approved')"
							groups="hr_novelty_client.group_novelty_process"/>

					<button name="action_set_to_approve" type="object"
							string="Set to Approve" invisible="state not in ('processed')"
							groups="hr_novelty_client.group_novelty_process"/>

					<button name="action_draft" type="object"
							string="Draft"
							invisible="state not in ('wait', 'wait_comments', 'wait_second_approval', 'approved')"/>

					<!-- Uncomment if necessary -->
					<!-- 
					<button name="action_cancel" type="object"
							string="Cancel"
							invisible="state not in ('wait', 'wait_comments', 'wait_second_approval', 'approved')"/>
					-->

					<button name="action_recruitment" class="btn-primary" type="object"
							string="Create Recruitment"
							invisible="not hr_job_id or is_recruitment or state not in ('approved') or hr_novelty_job_id"/>

					<field name="state" widget="statusbar"
						   statusbar_visible="wait,approved,processed"/>
				</header>
				<sheet> 
					<label for="name"/>
					<h1>
						<field name="name"/>
					</h1>
					<group>
						<group>
							<field name="type_id" required="1"
								  />
							<field name="subtype_id"
								   required="1"/>
							<field name="event_id" required="1"/>
							<field name="total_days"/>
						</group>
						<group>
							<field name="employee_id"
								   options="{'no_create': True, 'no_create_edit': True}"
								   required="not is_recruitment"/>
							<field name="identification_id"
								   invisible="company_only"/>
							<label for="start_date" string="Date"/>
							<div class="o_row o_row_readonly">
								<field name="start_date" class="oe_inline"/>
								<span class="oe_inline"
								invisible="not is_aplica_fecha_final or unit_half"> Hasta </span>
								<field name="end_date" class="oe_inline"
									   invisible="not is_aplica_fecha_final or unit_half" required="not event_id.is_aplica_fecha_final"/>
								<field name="approved_date"/>
							</div>
							<div class="o_row o_row_readonly"
								 invisible="type_id != %(hr_novelty_client.novelty_type_TIE)d">
								<label for="unit_half"/>
								<field name="unit_half"/>
								<field name="start_date_period"
									   class="oe_inline" string="In"
									   options="{'horizontal': True}"
									   required="unit_half" invisible="not unit_half"/>
							</div>  
							<field name="total_hours" invisible="is_horas_fijas"/>
						</group>
						<group>
							<field name="amount"/>
							<field name="total_fix_hours"
								   invisible="not is_horas_fijas"/>
							<field name="h_e_procedimiento"
								   invisible="not is_h_e_procedimiento" readonly="state in ('wait_comments','approved','processed','cancel', 'rejected')"/>
							<field name="responsible_id" readonly="state not in ['draft']"
								   invisible="not responsible_required" required="responsible_required"/>
							<field name="leave_id" readonly="1"
								   invisible="subtype_id != %(novelty_subtype_AUS)d"/>
							<field name="is_arl" readonly="state not in ['draft']"
								   invisible="not is_tipo_de_incapacidad"/>
							<field name="is_eps" readonly="state not in ['draft']"
								   invisible="not is_tipo_de_incapacidad"/>
							<field name="end_business_day" invisible="not is_end_business_day"/>
							<field name="description"/>
							<field name="leave_message" invisible="not leave_message" readonly="leave_message"/>
						</group>
					</group>
					<group string="Sección de reclutamiento" invisible="not is_recruitment">
						<field name="recruitment_reason_id"
							   required="is_recruitment"/>
						<field name="hr_job_id"/>
						<field name="currency_id"/>
						<field name="experience_id"/>
						<field name="hr_novelty_job_id"/>
						<field name="hr_novelty_job_id_state"
							   invisible="not hr_novelty_job_id"
							   string="Recruitment State"/>
						<field name="hiring_type"/>
						<field name="work_group_id"/>
						<field name="observation_recruitment"/>
						<field name="project_type"/>
						<field name="requires_knowledge_tests"/>
					</group>
					<notebook invisible="not is_recruitment">
						<page string="Language/Level Details">
							<field name="language_level_ids" nolabel="1">
								<tree editable="bottom">
									<field name="language_id"/>
									<field name="level_id"/>
								</tree>
								<form string="Language/Level Details">
									<sheet>
										<group col="4">
											<field name="language_id"/>
											<field name="level_id"/>
										</group>
									</sheet>
								</form>
							</field>
						</page>
						<page string="Level of Studies" name="level_studies">
							<field name="studies_ids"
								   nolabel="1"
								   readonly="state in ('approved','processed','cancel')">
								<tree editable="bottom">
									<field name="name" required="1"/>
									<field name="level" required="1"/>
								</tree>
							</field>
						</page>
						<page string="Salaries" name="salaries">
							<group>
								<group>
									<field name="hr_job_salary_id"
										readonly="state in ('wait_comments','approved','processed','cancel', 'rejected')"
									    options="{'no_open':'False', 'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"/>
								</group>
							</group>
						</page>
					</notebook>

					<group string="Contract Completion Section"
						   invisible="not is_motivo_de_retiro"
						   col="4" colspan="2">
						<field name="motivo_talento_id"
							   invisible="not is_motivo_de_retiro"
							   options="{'no_create': True, 'no_create_edit': True}"/>
					</group>
					<group string="Increase Salary"
						   invisible="not increase_salary"
						   col="4" colspan="2">
						<field name="wage"/>
						<field name="fix_wage_amount"/>
						<field name="flex_wage_amount"/>
						<field name="confidential"/>
						<field name="observation_increase"/>
					</group>
					<group string="License Attachment"
						   invisible="not requered_attachment_lic"
						   col="4" colspan="2">
						<field name="birth_certificate"/>
						<field name="certificate_born_alive"/>
						<field name="certificate_week_of_gestation"/>
						<field name="original_maternity_leave"/>
						<field name="relationship_id"
								options="{'no_create': True, 'no_create_edit': True}"/>
						<field name="leave_code_id"
								options="{'no_create': True, 'no_create_edit': True}"/>
					</group>
					<group name="contribution" string="Contribution"
						   invisible="not requered_account">
						<group>
							<field name="bank_account_id"
								   options="{'no_create': True, 'no_create_edit': True}"/>
							<field name="partner_id"
								   options="{'no_create': True, 'no_create_edit': True}"/>
						</group>
					</group>
					<group string="Documents Section"
						   invisible="not is_adjunto_obligatorio"
						   col="4" colspan="2">
						<field name="support" filename="file_name"
							   required="is_adjunto_obligatorio"/>
						<field name="support_name"/>
						<field name="support_size"/>
						<field name="support_attachment_url" widget="url"
							   readonly="id"/>
						<field name="file_name" invisible="1"/>
					</group>
					<group>
						<field name="reject_reason" colspan="4"
							   invisible="state != ('rejected')"/>
						<field name="responsible_required" invisible="1"/>
						<field name="company_only" invisible="1"/>
						<field name="is_aplica_fecha_final" invisible="1"/>
						<field name="is_requiere_adjunto" invisible="1"/>
						<field name="is_recruitment" invisible="1"/>
						<field name="is_user_appr" invisible="True"/>
						<field name="is_sec_appr_user" invisible="1"/>
						<field name="is_motivo_de_retiro" invisible="1"/>
						<field name="is_h_e_procedimiento" invisible="1"/>
						<field name="is_horas_fijas" invisible="1"/>
						<field name="transfer_employee" invisible="1"/>
						<field name="is_tipo_de_incapacidad" invisible="1"/>
						<field name="is_adjunto_obligatorio" invisible="1"/>
						<field name="requered_account" invisible="1"/>
						<field name="increase_salary" invisible="1"/>
						<field name="requered_attachment_lic" invisible="1"/>
						<field name="show_you" invisible="1"/>
						<field name="is_end_business_day" invisible="1"/>
						<field name="upc" invisible="1"/>
					</group>
					<group invisible="not upc">
						<group string="UPC" name="upc">
							<field name="family_id"
								   context="{'default_employee_id': employee_id}"/>
						</group>
					</group>
				</sheet>
				<div class="oe_chatter">
					<field name="message_follower_ids"
						   widget="mail_followers"/>
					<field name="activity_ids" widget="mail_activity"/>
					<field name="message_ids" widget="mail_thread"/>
				</div>
			</form>
		</field>
	</record>


