<?xml version="1.0"?>
<odoo>
	<record model="ir.ui.view" id="view_hr_novelty_form">
		<field name="name">hr.novelty.form</field>
		<field name="model">hr.novelty</field>
		<field name="type">form</field>
		<field name="arch" type="xml">
			<form string="hr.novelty">
				<header>
					<button name="action_wait" type="object"
							string="Wait" invisible="state not in ('draft')"/>
					<button name="action_wait_comments" type="object"
							string="Wait for Comments " invisible="state not in ('wait')"/>
					<button name="action_second_approval" type="object" invisible="not is_sec_appr_user or state in ('wait','approved')" string="Second Approve"/>
					<button name="action_approve" type="object"
							string="Approve"
							invisible="not (is_user_appr and state in ('wait', 'wait_comments'))"/>

					<button name="action_reject" type="object"
							string="Reject"
							invisible="not (state in ('wait', 'wait_comments', 'wait_second_approval') and (is_user_appr or is_sec_appr_user))"/>

					<button name="action_process" type="object"
							string="Process" invisible="state not in ('approved')"
							groups="hr_novelty_client.group_novelty_process"/>

					<button name="action_set_to_approve" type="object"
							string="Set to Approve" invisible="state not in ('approved','processed')"
							groups="hr_novelty_client.group_novelty_process"/>

					<button name="action_draft" type="object" string="Draft"
							invisible="state not in ('wait', 'wait_comments', 'wait_second_approval', 'approved')"/>

					<button name="action_draft" type="object" string="Set to Draft"
							groups="hr_novelty_client.group_novelty_reject_to_draft"
							invisible="state != 'rejected'"/>

					<button name="action_cancel" type="object" string="Cancel"
							invisible="state not in ('wait', 'wait_comments', 'wait_second_approval', 'approved')"/>

					<button name="action_recruitment" class="btn-primary" type="object" string="Create Recruitment"
							invisible="not (hr_job_id != False and is_recruitment and state == 'approved' and hr_novelty_job_id == False)"/>

					<button name="%(action_novelty_create_contact)d" type="action"
							string="Create Contact"
							invisible="state not in ('wait_second_approval', 'processed') or contact_id != False or is_recruitment == False"/>

					<button name="%(action_novelty_create_employee)d" type="action"
							string="Create Employee"
							invisible="state not in ('wait_second_approval', 'processed') or employee_id != False or contact_id == False or is_recruitment == False"/>

					<button name="%(action_novelty_create_contract)d" type="action"
							string="Create Contract"
							invisible="state not in ('wait_second_approval', 'processed') or contract_id != False or employee_id == False or is_recruitment == False"/>

					<button name="novelty_create_subcontract" type="object"
							string="Create Subcontract"
							invisible="contract_id == False or subcontract != False or increase_salary == False or state not in ('wait_second_approval', 'processed')"/>

					<field name="state" widget="statusbar"
						   statusbar_visible="wait,approved,processed"/>
				</header>
				<sheet>
					<label for="name"/>
					<h1>
						<field name="name"/>
					</h1>
					<group>
						<group>
							<field name="type_id" readonly="state in ('draft', 'wait', 'wait_comments',  'approved','processed', 'cancel', 'rejected')" force_save="1"/>
							<field name="event_id" required="1" readonly="state in ( 'wait_comments', 'approved' ,'processed', 'cancel', 'rejected')"/>
							<field name="identification_id" invisible="company_only"/>
							<field name="total_days" string="Total Days" readonly="state in ( 'wait_comments',  'approved','processed', 'cancel', 'rejected')"/>
						</group>
						<group>
							<field name="subtype_id" readonly="state in ('draft','wait', 'wait_comments', 'approved','processed', 'cancel', 'rejected')" force_save="1"/>
							<field name="employee_id"
								   options="{'no_create': True, 'no_create_edit': True}"
								   required="not is_recruitment"
								   readonly="state in ( 'wait_comments', 'approved','processed', 'cancel', 'rejected')"/>
							<field name="company_id" readonly="state in ( 'wait_comments', 'approved','processed', 'cancel', 'rejected')"/>
							
							<label for="start_date" string="Date"/>
							<div>
								<div class="o_row o_row_readonly">
									<field name="start_date" class="oe_inline" readonly="state in ( 'wait_comments', 'approved', 'processed', 'cancel', 'rejected')"/>
									<span class="oe_inline"
									> Hasta </span>
									<field name="end_date" class="oe_inline" required="is_aplica_fecha_final" readonly="state in ( 'wait_comments', 'approved','processed', 'cancel', 'rejected')"/>
									<field name="approved_date" readonly="state in ('wait_comments', 'approved','processed', 'cancel', 'rejected')"/>
								</div>
								<div class="o_row o_row_readonly"
									 invisible="type_id != %(hr_novelty_client.novelty_type_TIE)d">
									<label for="unit_half"/>
									<field name="unit_half"/>
									<field name="start_date_period" class="oe_inline"
										   string="In"
										   options="{'horizontal': True}"
										   required="unit_half" invisible="not unit_half"/>
								</div>
							</div>
							<field name="total_hours" invisible="not is_horas_fijas" string="Total hour" readonly="state in ( 'wait_comments', 'approved','processed','cancel', 'rejected') or is_horas_fijas"/>
							<field name="total_fix_hours" invisible="not is_horas_fijas" readonly="state in ('wait_comments', 'approved','processed','cancel', 'rejected')"/>
						</group>
						<group>
							<field name="amount" string="Amount" readonly="state in ('wait_comments', 'approved','processed','cancel', 'rejected')"/>
							<field name="h_e_procedimiento"
								   readonly="state in ('wait_comments', 'approved','processed','cancel', 'rejected')"
								   invisible="not is_h_e_procedimiento"/>
							<field name="responsible_id" invisible="not responsible_required"
							required="responsible_required" readonly="state not in ['draft']"/>
							<field name="leave_id" readonly="1" invisible="subtype_id != %(novelty_subtype_AUS)d"/>
							<field name="is_arl" readonly="state in ('wait_comments','approved','processed','cancel', 'rejected')"
								   invisible="not is_tipo_de_incapacidad"/>
							<field name="is_eps" readonly="state in ('wait_comments','approved','processed','cancel', 'rejected')"
								   invisible="not is_tipo_de_incapacidad"/>
							<field name="approved_by" invisible="not approved_by" readonly="approved_by"/>
							<field name="end_business_day" readonly="state in ('wait_comments','approved','processed','cancel', 'rejected')"
								   invisible="not is_end_business_day"/>
							<field name="description" readonly="state not in ('draft')"/>
							<field name="leave_message"
							   invisible="not leave_message" readonly="leave_message"/>
					   </group>
					</group>
					<group string="Sección de reclutamiento" invisible="not is_recruitment">
						<!-- <field name="recruitment_reason_id"
							   required="not is_recruitment" readonly="state in ('approved','processed','cancel')"/> -->
						<field name="hr_job_id"
							   readonly="state in ('wait_comments','approved','processed','cancel', 'rejected')"/>
						<field name="currency_id"
							   readonly="state in ('wait_comments','approved','processed','cancel', 'rejected')"/>
						<field name="experience_id"
							   readonly="state in ('wait_comments','wait_comments','approved','processed','cancel', 'rejected')"/>
						<field name="hr_novelty_job_id"
							   readonly="state in ('wait_comments','approved','processed','cancel')"/>
						<field name="hr_novelty_job_id_state"
							   invisible="not hr_novelty_job_id" readonly="state in ('wait_comments','approved','processed','cancel', 'rejected')" string="Recruitment State"/>
						<field name="hiring_type"
							   readonly="state in ('wait_comments','approved','processed','cancel', 'rejected')"/>
						<field name="work_group_id"
							   readonly="state in ('wait_comments','approved','processed','cancel', 'rejected')"/>
						<field name="observation_recruitment"
							   readonly="state in ('wait_comments','approved','processed','cancel', 'rejected')"/>
						<field name="project_type"
							   readonly="state in ('wait_comments','approved','processed','cancel', 'rejected')"/>
						<field name="contact_id" readonly="1"/>
						<field name="contract_id" readonly="1"/>
						<field name="wage_assign"
							   readonly="state in ('wait_comments','approved','processed','cancel', 'rejected')"/>
						<field name="Fix_wage_assing"
							   readonly="state in ('wait_comments','approved','processed','cancel', 'rejected')"/>
						<field name="subcontract" invisible="1"/>

						<field name="confidential"
							   readonly="state in ('wait_comments', 'approved','processed','cancel', 'rejected')"/>
						<field name="bill_id"
							   options="{'no_create': True, 'no_create_edit': True}"
							   readonly="state in ('wait_comments','approved','processed','cancel', 'rejected')"/>
						<field name="specific_knowledge"
							   readonly="state in ('wait_comments','approved','processed','cancel', 'rejected')"/>
						<field name="start_of_work"
							   readonly="state in ('wait_comments','approved','processed','cancel', 'rejected')"/>

						<field name="temporary_contract"
							   readonly="state in ('wait_comments','approved','processed','cancel', 'rejected')"/>
						<field name="contract_end_date"
							   readonly="state in ('wait_comments','approved','processed','cancel', 'rejected')" invisible="not temporary_contract"/>

						<field name="hr_payroll_structure_id"
							   options="{'no_create': True, 'no_create_edit': True}"
							   readonly="state in ('wait_comments','approved','processed','cancel', 'rejected')"/>

						<field name="hr_salary_structure_type_id"
							   readonly="state in ('wait_comments','approved','processed','cancel', 'rejected')"/>
						<field name="functions_job" readonly="state in ('wait_comments','approved','processed','cancel', 'rejected')"/>
						<field name="requires_knowledge_tests" readonly="state in ('wait_comments','approved','processed','cancel', 'rejected')"/>

					</group>
					<notebook invisible="not is_recruitment">
						<page string="Language/Level Details">
							<field name="language_level_ids"
								   nolabel="1"
								   readonly="state in ('wait_comments','approved','processed','cancel', 'rejected')">
								<tree editable="bottom">
									<field name="language_id"/>
									<field name="level_id"/>
								</tree>
								<form string="Language/Level Details">
									<sheet>
										<group col="4">
											<field name="language_id"/>
											<field name="level_id"/>
										</group>
									</sheet>
								</form>
							</field>
						</page>
						<page string="Level of Studies" name="level_studies">
							<field name="studies_ids"
								   nolabel="1"
								   readonly="state in ('wait_comments','approved','processed','cancel', 'rejected')">
								<tree editable="bottom">
									<field name="name" required="1"/>
									<field name="level" required="1"/>
								</tree>
							</field>
						</page>
						<page string="Salaries" name="salaries">
							<group>
								<group>
									<field name="hr_job_salary_id"
										   readonly="state in ('wait_comments','approved','processed','cancel', 'rejected')"
										   options="{'no_open':'False', 'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"/>
								</group>
							</group>
						</page>
					</notebook>
					<group string="Contract Completion Section"
						   invisible="not is_motivo_de_retiro"
						   col="4" colspan="2">
						<field name="motivo_talento_id"
							   invisible="not is_motivo_de_retiro"
							   readonly="state in ('wait_comments','approved', 'processed', 'cancel', 'rejected')"
							   options="{'no_create': True, 'no_create_edit': True}"/>
					</group>
					<group string="Increase Salary"
						   invisible="not increase_salary"
						   >
						   <group>
								<field name="wage" />
								<field name="fix_wage_amount" />
								<field name="flex_wage_amount" />
							</group>
							<group>
								<field name="confidential" readonly="state in ('wait_comments','approved', 'processed', 'cancel', 'rejected')"/>
								<field name="observation_increase" readonly="state in ('wait_comments','approved', 'processed', 'cancel', 'rejected')"/>
							</group>
					</group>
					<group string="License Attachment"
						   invisible="not requered_attachment_lic">
					    <group>
							<field name="birth_certificate" readonly="state in ('wait_comments','approved', 'processed', 'cancel', 'rejected')" required="requered_attachment_lic"/>
							<field name="certificate_born_alive" readonly="state in ('wait_comments','approved', 'processed', 'cancel', 'rejected')" required="requered_attachment_lic"/>
							<field name="certificate_week_of_gestation" readonly="state in ('wait_comments','approved', 'processed', 'cancel', 'rejected')" required="requered_attachment_lic"/>
						</group>
						<group>
							<field name="original_maternity_leave" readonly="state in ('wait_comments', 'approved', 'processed', 'cancel', 'rejected')" required="requered_attachment_lic"/>
							<field name="relationship_id" readonly="state in ('wait_comments', 'approved', 'processed', 'cancel', 'rejected')"
									options="{'no_create': True, 'no_create_edit': True}"/>
							<field name="leave_code_id" readonly="state in ('wait_comments','approved', 'processed', 'cancel', 'rejected')"
							options="{'no_create': True, 'no_create_edit': True}"/>
						</group>
					</group>
					<group name="contribution" string="Contribution"
						   invisible="not requered_account">
						<group>
							<field name="bank_account_id" readonly="state in ('wait_comments','approved', 'processed', 'cancel', 'rejected')"/>
							<field name="partner_name"/>
							<field name="partner_id" invisible="1"/>
						</group>
					</group>
					<group string="Documents Section"
						   invisible="not is_adjunto_obligatorio">
						   <group>
								<field name="support" filename="file_name" readonly="state in ('wait_comments','approved', 'processed', 'cancel', 'rejected')"
									   required="is_adjunto_obligatorio"/>
								<field name="support_size" readonly="state in ('wait_comments','approved', 'processed', 'cancel', 'rejected')"/>
							</group>
							<group>
								<field name="support_name" readonly="state in ('wait_comments','approved', 'processed', 'cancel', 'rejected')"/>
								<field name="support_attachment_url"
									   widget="url"
									   readonly="id"/>
								<field name="file_name" invisible="1"/>
							</group>
					</group>
					<group groups="base.group_system">
						<group string="Data Sign">
							<field name="date" readonly="1"/>
							<field name="location" readonly="1"/>
							<field name="ip_from" readonly="1"/>
						</group>
						<group string="Approved Data Sign"
							   invisible="state not in ('wait_comments','approved','processed', 'rejected','cancel',)">
							<field name="approved_ip_date" readonly="1"
								   string="Date"/>
							<field name="approved_location" readonly="1"
								   string="Location"/>
							<field name="approved_ip_from" readonly="1"
								   string="IP From"/>
						</group>
					</group>
					<group>
						<field name="reject_reason" colspan="4"
							   invisible="state != ('rejected')"/>
						<field name="responsible_required" invisible="1"/>
						<field name="company_only" invisible="1"/>
						<field name="is_aplica_fecha_final" invisible="1"/>
						<field name="is_requiere_adjunto" invisible="1"/>
						<field name="is_recruitment" invisible="1"/>
						<field name="is_user_appr" invisible="True"/>
						<field name="is_sec_appr_user" invisible="1"/>
						<field name="is_motivo_de_retiro" invisible="1"/>
						<field name="is_h_e_procedimiento" invisible="1"/>
						<field name="is_horas_fijas" invisible="1"/>
						<field name="is_tipo_de_incapacidad" invisible="1"/>
						<field name="is_adjunto_obligatorio" invisible="1"/>
						<field name="requered_account" invisible="1"/>
						<field name="increase_salary" invisible="1"/>
						<field name="requered_attachment_lic" invisible="1"/>
						<field name="show_you" invisible="1"/>
						<field name="is_end_business_day" invisible="1"/>
						<field name="upc" invisible="1"/>
					</group>
					<group invisible="not upc">
						<group string="UPC" name="upc">
							<field name="family_id" readonly="state in ('wait_comments','approved', 'processed','cancel', 'rejected')"
								   context="{'default_employee_id': employee_id}"/>
						</group>
					</group>
				</sheet>
				<div class="oe_chatter">
					<field name="message_follower_ids"
						   widget="mail_followers"/>
					<field name="activity_ids" widget="mail_activity"/>
					<field name="message_ids" widget="mail_thread"/>
				</div>
			</form>
		</field>
	</record>


	<record model="ir.ui.view" id="view_hr_novelty_tree">
		<field name="name">hr.novelty.tree</field>
		<field name="model">hr.novelty</field>
		<field name="type">tree</field>
		<field name="arch" type="xml">
			<tree string="hr.novelty">
				<field name="name"/>
				<field name="type_id"/>
				<field name="subtype_id"/>
				<field name="event_id"/>
				<field name="employee_id"/>
				<field name="start_date"/>
				<field name="end_date"/>
				<field name="total_days"/>
				<field name="state"/>
				<field name="company_id"/>
			</tree>
		</field>
	</record>

	<record id="view_hr_novelty_search" model="ir.ui.view">
		<field name="name">hr.novelty.search</field>
		<field name="model">hr.novelty</field>
		<field name="arch" type="xml">
			<search string="Hr Novelty">
				<field name="name"/>
				<field name="type_id"/>
				<field name="subtype_id"/>
				<field name="event_id"/>
				<field name="employee_id"/>
				<field name="state"/>
				<field name="start_date"/>
				<field name="end_date"/>
				<field name="company_id"/>
				<filter string="Draft" name="draft"
						domain="[('state','=','draft')]"/>
				<filter string="Wait" name="wait"
						domain="[('state','=','wait')]"/>
				<filter string="Wait for comments" name="wait_comments"
						domain="[('state','=','wait_comments')]"/>
				<filter string="Waiting Second Approval"
						name="wait_second_approval"
						domain="[('state','=','wait_second_approval')]"/>
				<filter string="Approved" name="approved"
						domain="[('state','=','approved')]"/>
				<filter string="Processed" name="processed"
						domain="[('state','=','processed')]"/>
				<filter string="Cancel" name="cancel"
						domain="[('state','=','cancel')]"/>
				<filter string="Rejected" name="rejected"
						domain="[('state','=','rejected')]"/>
				<group string="Group By">
					<filter string="Type" name="grp_type_id"
							context="{'group_by':'type_id'}"/>
					<filter string="Subtype" name="grp_subtype_id"
							context="{'group_by':'subtype_id'}"/>
					<filter string="Event" name="grp_event_id"
							context="{'group_by':'event_id'}"/>
					<filter string="Employee" name="grp_employee_id"
							context="{'group_by':'employee_id'}"/>
					<filter string="Status" name="grp_state"
							context="{'group_by':'state'}"/>
					<filter string="Identification No"
							name="identification_id"
							context="{'group_by':'identification_id'}"/>
				</group>
			</search>
		</field>
	</record>
	
	<record model="ir.actions.act_window" id="action_hr_novelty">
	    <field name="name">Novelty</field>
	    <field name="res_model">hr.novelty</field>
	    <field name="view_mode">tree,form</field>
	    <field name="search_view_id" ref="view_hr_novelty_search"/>
	    <field name="domain">[('company_id', 'in', allowed_company_ids)]</field>
	</record>

	<record model="ir.ui.view" id="view_hr_novelty_event_form">
		<field name="name">hr.novelty.event.form</field>
		<field name="model">hr.novelty.event</field>
		<field name="type">form</field>
		<field name="arch" type="xml">
			<form string="hr.novelty.event">
				<sheet>
					<div class="oe_button_box" name="button_box">
						<button class="oe_stat_button" type="object"
								name="toggle_active" icon="fa-archive">
							<field name="active" widget="boolean_button"
								   options='{"terminology": "archive"}'/>
						</button>
					</div>
					<group col="4">
						<group colspan="2" name="general"
							   string="General Configuration">
							<field name="name"/>
							<field name="type_id" required="1"/>
							<field name="subtype_id"
								   domain="[('type_id','in',[type_id])]"
								   required="1"/>
							<field name="affectation" widget="radio"/>
							<field name="you_model_id"/>
						</group>
						<group name="time" string="Time Configuration"
							   colspan="2"
							   invisible="type_id != %(novelty_type_TIE)d">
							<field name="leave_type_id"
								   invisible="subtype_id != %(novelty_subtype_AUS)d"/>
							<field name="restriction_day"/>
							<field name="min_days"/>
							<field name="max_days"/>
							<field name="calendar_type"/>
							<field name="limit_advance"/>
							<field name="advance_holidays"/>
							<field name="projection_vacation"/>
						</group>
						<group colspan="2">
							<field name="is_recruitment"/>
							<field name="new_recruitment"
								  invisible="not is_recruitment"/>
							<field name="is_aplica_fecha_final"/>
							<field name="is_requiere_adjunto"/>
							<field name="is_motivo_de_retiro"/>
							<field name="unjustified"/>
							<field name="transfer_employee"/>
						</group>
						<group colspan="2">
							<field name="is_h_e_procedimiento"/>
							<field name="is_horas_fijas"/>
							<field name="is_tipo_de_incapacidad"/>
							<field name="is_adjunto_obligatorio"/>
							<field name="requered_account"/>
							<field name="increase_salary"/>
							<field name="requered_attachment_lic"/>
							<field name="show_you"/>
							<field name="exhibit_event"/>
							<field name="half_time_permission"/>
							<field name="restrict_by_gender"/>
							<field name="gender" invisible="not restrict_by_gender"/>
							<field name="is_end_business_day"/>
							<field name="upc"/>
						</group>
					</group>

					<notebook>
						<page name="details" string="Details">
							<group col="4">
								<field name="sara"/>
								<field name="description"/>
							</group>
						</page>
						<page name="approval" string="Approval">
							<group col="4">
								<field name="approver" widget="radio"/>
								<label for="second_approver_required"
									   string="Second Approver Required"/>
								<div class="o_row o_row_readonly">
									<field name="second_approver_required"
										   class="oe_inline"/>
									<field name="second_approver_group_id"
										   invisible="not second_approver_required"
										   class="oe_inline"/>
								</div>
								<label for="is_optional_approver"/>
								<div class="o_row o_row_readonly">
									<field name="is_optional_approver" class="oe_inline"/>
									<field name="optional_approver_group_id"
										   invisible="not is_optional_approver"
										   class="oe_inline"
										   options="{'no_create': True, 'no_create_edit': True}"/>
								</div>
								<label for="is_optional_approver_2"/>
								<div class="o_row o_row_readonly">
									<field name="is_optional_approver_2"
										   class="oe_inline"/>
									<field name="optional_approver2_group_id"
										   invisible="not is_optional_approver_2"
										   class="oe_inline"
										   options="{'no_create': True, 'no_create_edit': True}"/>
								</div>
							</group>
						</page>

