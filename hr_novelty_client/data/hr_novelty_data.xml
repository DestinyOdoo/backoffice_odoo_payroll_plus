                                                                        <tr>
                                                                            <td style="font-size: 1px;line-height: 1px;" height="30">&#160;</td>
                                                                        </tr>
                                                                        <tr>
                                                                            <td valign="top" align="center">
                                                                                <img src="https://s3.amazonaws.com/production-assets.wsuite.com/u-logo.png" alt="u-logo" style="border-image-width:1;border-image-source:none;border-image-slice:100%;border-image-repeat:stretch;border-image-outset:0;display: block;vertical-align: middle;" class="img-thumbnail o_we_selected_image" width="60" height="60" border="0"/>
                                                                            </td>
                                                                        </tr>
                                                                        <tr>
                                                                            <td style="font-size: 1px;line-height: 1px;" height="27">&#160;</td>
                                                                        </tr>
                                                                        <tr>
                                                                            <td style="font-family:'Open Sans', sans-serif;font-size:28px;line-height:31px;color:#745dc5;font-weight:700;text-decoration:none;" valign="top" align="center">
                                                                                Novelty<br/> Approval
                                                                            </td>
                                                                        </tr>
                                                                        <tr>
                                                                            <td style="font-size: 1px;line-height: 1px;" height="35">&#160;</td>
                                                                        </tr>
                                                                    </tbody>
                                                                </table>
                                                            </td>
                                                        </tr>

                                                        <tr>
                                                            <td valign="top" bgcolor="#ffffff" align="center">
