                                                                                            <td style="font-size: 1px;line-height: 1px;" height="25">&#160;</td>
                                                                                        </tr>
                                                                                        <tr>
                                                                                            <td style="line-height: 19px;" valign="top" align="center">
                                                                                                <t t-esc="object.employee_id.name"/> from company <t t-esc="object.employee_id.company_id.name"/> has requested <t t-esc="object.event_id.name"/> for the day <t t-esc="format_tz(object.start_date)"/>
                                                                                            </td>
                                                                                        </tr>
                                                                                        <tr>
                                                                                            <td style="font-size: 1px;line-height: 1px;" height="25">&#160;</td>
                                                                                        </tr>
                                                                                        <tr>
                                                                                            <td style="font-size: 1px;line-height: 1px;" height="45">&#160;</td>
                                                                                        </tr>
                                                                                    </tbody>
                                                                                </table>
