<odoo>
        <record id="email_template_novelties_approval_reminder" model="mail.template">
            <field name="name">Novelties Approval Reminder</field>
            <field name="model_id" ref="model_hr_novelty"/>
            <field name="email_from">{{ object.company_id.email or 'admin@wsuite.com' }}</field>
            <field name="subject">Novelties Approval Reminder</field>
