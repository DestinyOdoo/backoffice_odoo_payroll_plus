                                                                            <td width="125">&#160;</td>
                                                                        </tr>
                                                                    </tbody>
                                                                </table>
                                                            </td>
                                                        </tr>

                                                        <tr>
                                                            <td valign="top" align="center">
                                                                <table width="700" cellspacing="0" cellpadding="0" border="0" bgcolor="#ffffff" align="center">
                                                                    <tbody>
                                                                        <tr>
                                                                            <td valign="top" align="left">
                                                                                <table width="100%" cellspacing="0" cellpadding="0" border="0" align="left">
                                                                                    <tbody>
                                                                                        <tr>
                                                                                            <td valign="top" align="center">
                                                                                                <table width="700" cellspacing="0" cellpadding="0" border="0" align="center">
                                                                                                    <tbody>
                                                                                                        <tr>
                                                                                                            <td style="font-size:1px;line-height:1px" height="1" bgcolor="#e5e5e5">&#160;</td>
                                                                                                        </tr>
                                                                                                    </tbody>
                                                                                                </table>
                                                                                            </td>
                                                                                        </tr>
                                                                                        <tr>
                                                                                            <td style="font-size: 1px;line-height: 1px;" height="30">&#160;</td>
                                                                                        </tr>
                                                                                        <tr>
                                                                                            <td style="font-family:'Open Sans', sans-serif;font-size:11px;line-height:15px;color:#404040;font-weight:normal;" valign="top" align="center">
                                                                                                You received this email because you are registered on <a href="https://www.wsuite.com" style="text-decoration:none;font-family:'Montserrat',sans-serif;font-size:11px;line-height:15px;color:#404040;font-weight:normal;">wsuite.com</a> with the email address<br/> <a href="mailto:email@server.com" style="text-decoration:none;font-family:'Montserrat',sans-serif;font-size:11px;line-height:15px;color:#745dc5;font-weight:700;">email@server.com</a>
                                                                                            </td>
                                                                                        </tr>
                                                                                        <tr>
                                                                                            <td style="font-size: 1px;line-height: 1px;" height="20">&#160;</td>
                                                                                        </tr>
                                                                                        <tr>
                                                                                            <td style="line-height: 14px;" valign="top" align="center">
                                                                                                <font color="#1c1c1c">
                                                                                                    <span style="font-size: 11px;">All Rights Reserved 2020</span>
                                                                                                </font>
                                                                                            </td>
                                                                                        </tr>
                                                                                        <tr>
                                                                                            <td style="font-size: 1px;line-height: 1px;" height="25">&#160;</td>
                                                                                        </tr>
                                                                                    </tbody>
                                                                                </table>
                                                                            </td>
                                                                        </tr>
                                                                    </tbody>
                                                                </table>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </field>
            
            <field name="lang">{{ user.partner_id.lang }}</field>
            <!-- <field name="user_signature" eval="False"/> -->
            <field name="auto_delete" eval="True"/>
