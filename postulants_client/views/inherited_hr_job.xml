<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- hr.job -->
    <record id="view_hr_job_form_state" model="ir.ui.view">
        <field name="name">hr.job.form</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="before">
                <header>
                    <button name="set_recruit" string="Start Recruitment" invisible="state not in ['open','pause','canceled']" type="object" groups="base.group_user"/>
                    <button name="set_open" string="Open Recruitment" invisible="state not in ['recruit', 'pause','canceled']"  type="object" groups="base.group_user"/>
                    <button name="set_pause" string="Pause" invisible="state not in ['recruit']"   type="object" groups="base.group_user"/>
                    <button name="set_cancel" string="Cancel Recruitment" invisible="state not in ['recruit']"  type="object" groups="base.group_user"/>
                    <field name="state" widget="statusbar" statusbar_visible="recruit,open,pause,canceled"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="hr_reason_changed_id"
                    invisible="state not in ['pause', 'canceled']"
                    required="state in ['pause', 'canceled']"/>
            </xpath>
        </field>
    </record>

</odoo>